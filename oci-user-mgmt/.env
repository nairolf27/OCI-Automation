# Path to the JSON file describing the desired identity state.
# Defaults to oci_identity_users.json in the project root.
OCI_IDENTITY_USERS_FILE=oci_identity_users.json

# Set to "false" to skip the interactive confirmation prompt.
REQUIRE_VALIDATION=true

# Keyword the operator must type to confirm planned changes.
VALIDATION_KEYWORD=OK

# Directory where log files are stored.
LOG_DIR=logs

# Log file name
LOG_FILENAME=oci-user-mgmt

# Delay in seconds between OCI API calls to avoid hitting rate limits.
OCI_API_DELAY=0.2

# OCI CONFIG
ENV_OCI_CONFIG=false
OCI_TENANCY_OCID=ocid1.tenancy.oc1....
OCI_USER_OCID=ocid1.user.oc1....
OCI_FINGERPRINT=12:34:56:78:90:ab:cd
OCI_REGION=eu-paris-1
OCI_PRIVATE_KEY=/home/user/.oci/oci_api_key.pem
