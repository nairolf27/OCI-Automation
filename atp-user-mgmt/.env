# ─────────────────────────────────────────────────────────────────────────────
#  Oracle ATP – ORDS User Reconciler
#  Environment configuration
# ─────────────────────────────────────────────────────────────────────────────

# Admin password per database instance.
# The key pattern is: <DB_NAME>_ORDS_ADMIN_PASSWORD
# <DB_NAME> must match exactly (case-sensitive) the key used in atp_users.json.
PROD_ORDS_ADMIN_PASSWORD=your_prod_admin_password_here
DEV_ORDS_ADMIN_PASSWORD=your_dev_admin_password_here

# ORDS SQL endpoint path (relative to base_url/admin_user)
# Default: /_/sql
ORDS_SQL_PATH=/_/sql

# Path to the user configuration JSON file
ATP_USERS_FILE=atp_users.json

# Whether to require manual confirmation before applying changes (true/false)
REQUIRE_VALIDATION=true

# Keyword the operator must type to confirm execution
VALIDATION_KEYWORD=OK

# Log directory (relative to this file's location)
LOG_DIR=logs

# HTTP request timeout in seconds
HTTP_TIMEOUT=30

# Delay (seconds) between successive SQL requests to avoid rate-limiting
REQUEST_DELAY=0.3